{
  "name": "am-language",
  "displayName": "AM Language",
  "description": "AM programming language by Anuj Mishra: Python syntax with fewer bugs. Colours, live errors with hints, and a Run button for .am files.",
  "version": "0.1.2",
  "publisher": "chaman640",
  "author": {
    "name": "Anuj Mishra",
    "url": "https://github.com/chaman640"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1f4e8c",
    "theme": "dark"
  },
  "homepage": "https://chaman640.github.io/Python-based-language.am/",
  "bugs": {
    "url": "https://github.com/chaman640/Python-based-language.am/issues"
  },
  "keywords": [
    "am",
    "am language",
    "am-language",
    "python",
    "beginners",
    "anuj mishra",
    "programming language",
    "education"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chaman640/Python-based-language.am"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Education"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:am"
  ],
  "contributes": {
    "languages": [
      {
        "id": "am",
        "aliases": [
          "AM",
          "am"
        ],
        "extensions": [
          ".am"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "am",
        "scopeName": "source.am",
        "path": "./syntaxes/am.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "am.runFile",
        "title": "Run AM File",
        "category": "AM",
        "icon": "$(play)"
      },
      {
        "command": "am.checkFile",
        "title": "Check AM File for Problems",
        "category": "AM"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "am.runFile",
          "when": "resourceLangId == am",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "am.runFile",
          "when": "editorLangId == am"
        },
        {
          "command": "am.checkFile",
          "when": "editorLangId == am"
        }
      ]
    },
    "configuration": {
      "title": "AM",
      "properties": {
        "am.command": {
          "type": "string",
          "default": "am",
          "description": "Command used to run and check AM files, e.g. \"am\" or \"python -m amlang\"."
        },
        "am.checkWhileTyping": {
          "type": "boolean",
          "default": true,
          "description": "Show AM errors and warnings while you type (otherwise only on save)."
        }
      }
    }
  }
}
